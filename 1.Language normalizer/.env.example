APP_NAME=audio-agent
WEBHOOK_SECRET=dev-secret-123
ASR_CONFIDENCE_THRESHOLD=0.60
TEMP_AUDIO_DIR=./tmp_audio

# Only needed if ffmpeg isn't on PATH - point this at ffmpeg.exe directly.
# FFMPEG_EXECUTABLE=C:\path\to\ffmpeg.exe

# faster-whisper model size/device - see https://github.com/SYSTRAN/faster-whisper
# WHISPER_MODEL_SIZE=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8

# Bhashini ULCA translation pipeline - get these from your Bhashini account.
# Leave blank to run with translation disabled (passthrough).
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# Self-hosted Santali ASR/translation/TTS - Bhashini has no Santali model
# at all, so this one language is served by santali-voice-service/
# (started via the repo's root docker-compose.yml) instead.
SANTALI_VOICE_SERVICE_URL=http://localhost:8100

# Object storage (MinIO / any S3-compatible endpoint) - uploaded citizen
# audio is persisted here in addition to the local_audio_dir temp copy this
# service keeps for ffmpeg/faster-whisper. Matches the MinIO service in
# "3.Triage and route/docker-compose.yml".
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_ACCESS_KEY=sahyog
S3_SECRET_KEY=sahyog-dev-secret
S3_REGION=us-east-1
S3_USE_SSL=false
S3_BUCKET_AUDIO=sahyog-audio
S3_BUCKET_IMAGES=sahyog-images

# Optional. Same Postgres instance/DB as "3.Triage and route". Only used to
# register each upload in the shared media_objects table (see
# schema_003_media_objects.sql) - leave blank to skip the DB row and still
# get durable object storage.
DATABASE_URL=

