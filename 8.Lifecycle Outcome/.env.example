DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/dno_triage

ULB_DISPATCH_BASE_URL=http://localhost:8004
TRANSPARENCY_BASE_URL=http://localhost:8009
INTERNAL_SERVICE_TOKEN=
ADMIN_FORM_PASSWORD=

# Optional: "2.Evidence Extractor"'s C3 vision endpoint, reused for pilot
# closure verification, same optional-hook pattern as 5.ULB Dispatch's
# VISION_CLASSIFIER_URL. Leave blank to skip auto visual verification and
# require manual review instead.
VISION_CLASSIFIER_URL=
CLOSURE_GEO_RADIUS_METERS=150
MAX_PILOT_PHOTO_MB=8

# Object storage (MinIO / any S3-compatible endpoint) - pilot validation
# photos are uploaded here instead of the local "pilot_uploads/" disk
# folder. Matches the MinIO service in "3.Triage and route/docker-compose.yml".
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_ACCESS_KEY=sahyog
S3_SECRET_KEY=sahyog-dev-secret
S3_REGION=us-east-1
S3_USE_SSL=false
S3_BUCKET_AUDIO=sahyog-audio
S3_BUCKET_IMAGES=sahyog-images
