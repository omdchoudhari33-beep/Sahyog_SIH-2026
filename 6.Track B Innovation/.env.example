# Same Postgres instance/DB as "3.Triage and route" and "5.ULB Dispatch" -
# this service owns its own tables there, does not create/use a separate DB.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/dno_triage

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

STATUS_LINK_BASE_URL=http://localhost:8006
MATCH_TOKEN_TTL_HOURS=168
MAX_HEI_MATCH_ATTEMPTS=5

# Where to notify once a proposal is approved (fire-and-forget, same pattern
# as 3.Triage and route -> here). Leave as-is unless those services run on
# different hosts/ports.
INDUSTRY_PARTNERSHIP_BASE_URL=http://localhost:8007
LIFECYCLE_OUTCOME_BASE_URL=http://localhost:8008
TRANSPARENCY_BASE_URL=http://localhost:8009

# Same repo-wide internal-services secret already configured for
# 3.Triage and route <-> 5.ULB Dispatch. Required, no default; app refuses
# to start without it outside debug mode.
INTERNAL_SERVICE_TOKEN=
ADMIN_FORM_PASSWORD=

EMAIL_DRY_RUN=true
SEED_DEMO_DATA=true
DEMO_HEI_NAME=Demo Institute of Technology
DEMO_HEI_CONTACT_EMAIL=demo-hei-inbox@example.com

# Read-only: same object storage endpoint 9.Transparency Layer resolves
# media_objects against, reused to render the citizen's report photo inside
# the broadcast brief (app/brief.py). No S3_ACCESS_KEY/SECRET_KEY needed.
S3_PUBLIC_BASE_URL=http://localhost:9000
# How many top-matching HEIs get the informational problem brief broadcast
# (app/matcher.py::broadcast_to_top_n) - independent of the single active
# accept/decline match.
BROADCAST_TOP_N=10
