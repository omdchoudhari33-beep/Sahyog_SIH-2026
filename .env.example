# Single source of truth for docker-compose.yml. Copy to ".env" and fill in
# real values before `docker compose up --build`. Per-service ".env" files
# (each numbered folder's own) are untouched and keep working unchanged for
# anyone running services outside Docker via start_pipeline.py.

# ---- Shared secrets (must be identical across every service that uses
# them - this is the same repo-wide convention every service's own config
# comments already describe) ----
INTERNAL_SERVICE_TOKEN=change-me-internal-token
ADMIN_PORTAL_PASSWORD=change-me-admin-password
ADMIN_FORM_PASSWORD=change-me-admin-password
AGENT1_WEBHOOK_SECRET=change-me-webhook-secret

# ---- Postgres ----
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dno_triage

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=sahyog
MINIO_ROOT_PASSWORD=sahyog-dev-secret
# Browser-facing address citizen photo/audio URLs are built from - override
# to your real public domain in a real deployment. Services reach MinIO
# internally via the Docker service name regardless of this value.
S3_PUBLIC_BASE_URL=http://localhost:9000

# ---- CORS: origins allowed to call the backend from a browser ----
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- citizen-portal build-time backend URLs (browser-facing) ----
# NEXT_PUBLIC_* values are inlined into the frontend bundle at BUILD time,
# not read at container startup - `docker compose build citizen-portal`
# again after changing any of these.
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8005
NEXT_PUBLIC_AGENT1_URL=http://localhost:8001
NEXT_PUBLIC_AGENT2_URL=http://localhost:8002
NEXT_PUBLIC_AGENT3_URL=http://localhost:8003
NEXT_PUBLIC_AGENT9_URL=http://localhost:8009

# ---- Bhashini (real external translation/TTS pipeline) ----
# Leave blank to run with translation disabled (passthrough) - see
# "1.Language normalizer/app/config.py".
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_ULCA_API_KEY=your-bhashini-ulca-api-key
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# ---- Santali voice (self-hosted, santali-voice-service/) ----
# Bhashini has no Santali model at all, so ASR/translation/TTS for this one
# language run locally instead. Translation (IndicTrans2) and TTS (Indic
# Parler-TTS) use gated HuggingFace repos - get a token at
# https://huggingface.co/settings/tokens after accepting both models'
# access terms (both "auto"-gated - instant approval, no manual review):
#   https://huggingface.co/ai4bharat/indictrans2-indic-en-dist-200M
#   https://huggingface.co/ai4bharat/indictrans2-en-indic-dist-200M
#   https://huggingface.co/ai4bharat/indic-parler-tts
# Leave blank and Santali ASR (voice input) still works; translation/TTS
# calls fail with a clear "gated repo" error until this is set.
HF_TOKEN=

# ---- Hackathon fast-path defaults (services 5/6/7) ----
# See each service's own README "Hackathon fast-path" section - flip to
# false/production values for real email delivery and seeded demo removal.
SEED_DEMO_DATA=true
EMAIL_DRY_RUN=true
