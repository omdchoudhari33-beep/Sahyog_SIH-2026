AGENT1_BASE_URL=http://127.0.0.1:8001
AGENT2_BASE_URL=http://127.0.0.1:8002
AGENT3_BASE_URL=http://127.0.0.1:8003
AGENT5_BASE_URL=http://127.0.0.1:8004
AGENT6_BASE_URL=http://127.0.0.1:8006
AGENT7_BASE_URL=http://127.0.0.1:8007
AGENT8_BASE_URL=http://127.0.0.1:8008
AGENT9_BASE_URL=http://127.0.0.1:8009

# Must match Agent 1's WEBHOOK_SECRET
AGENT1_WEBHOOK_SECRET=dev-secret-123

# Same repo-wide internal-services secret already configured for
# 3.Triage and route <-> 5.ULB Dispatch <-> 6/7/8/9. The Admin Portal
# (below) uses this to call those services' internal-auth endpoints on
# behalf of an admin who already passed ADMIN_PORTAL_PASSWORD.
INTERNAL_SERVICE_TOKEN=

# Required, no default. Protects /dashboard, /admin, and every /api/* proxy
# route below them - a separate credential from INTERNAL_SERVICE_TOKEN
# (human login vs service-to-service call), same separation every other
# service in this repo uses.
ADMIN_PORTAL_PASSWORD=

REQUEST_TIMEOUT_SECONDS=240
DEFAULT_POPULATION_IMPACT=1.0
