# Same Postgres instance/DB as "3.Triage and route" - this service owns its
# own tables there (ulb_directory, ulb_contacts, dispatches, ...), it does
# not create or use a separate database.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/dno_triage

# SMTP (outbound officer emails). Ignored while EMAIL_DRY_RUN=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# IMAP (inbound officer reply polling, best-effort fallback path).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Public base URL the one-time officer status links are built from.
STATUS_LINK_BASE_URL=https://status.sahyog.example.gov.in
STATUS_LINK_TOKEN_TTL_HOURS=720

DISPATCH_MAX_RETRIES=3
DISPATCH_RETRY_BACKOFF_SECONDS=300
SLA_POLL_INTERVAL_SECONDS=900
INBOX_POLL_INTERVAL_SECONDS=300

# Optional: "2.Evidence Extractor"'s C3 vision endpoint, reused for closure
# photo verification. Leave blank to skip auto visual verification and
# require manual review instead.
# TODO(human): confirm the exact request/response shape against that
# service's actual /evidence/attach-photo contract before wiring this up
# for real - closure.py currently assumes a generic shape, see its comments.
VISION_CLASSIFIER_URL=

CLOSURE_GEO_RADIUS_METERS=150

# Required, no default. Shared secret between this service and
# "3.Triage and route" for the internal /dispatch/* routes. Both services
# must define the SAME value in their own .env file - it is not passed at
# runtime, it is configured twice. App refuses to start without this set
# outside debug mode.
INTERNAL_SERVICE_TOKEN=

# Required, no default. Protects /admin/onboard. Deliberately a SEPARATE
# secret from INTERNAL_SERVICE_TOKEN - different trust boundary (a human
# filling out a form vs. service-to-service calls).
ADMIN_FORM_PASSWORD=

DISPATCH_EMAIL_LANGUAGE=en
MAX_CLOSURE_PHOTO_MB=8

# Object storage (MinIO / any S3-compatible endpoint) - closure photos are
# uploaded here instead of the local "closure_uploads/" disk folder. Matches
# the MinIO service in "3.Triage and route/docker-compose.yml".
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_ACCESS_KEY=sahyog
S3_SECRET_KEY=sahyog-dev-secret
S3_REGION=us-east-1
S3_USE_SSL=false
S3_BUCKET_AUDIO=sahyog-audio
S3_BUCKET_IMAGES=sahyog-images

# --- Hackathon fast-path defaults (see README "Hackathon fast-path" section) ---
# All three below default to the fast/demo behavior. Flip all three to their
# non-default value to get back to the production-shaped behavior this
# service was originally designed for.
SEED_DEMO_DATA=true
DEMO_ULB_BOUNDARY_WKT=POLYGON((85.0 22.5,86.5 22.5,86.5 24.0,85.0 24.0,85.0 22.5))
DEMO_CONTACT_EMAIL=demo-ulb-inbox@example.com
EMAIL_DRY_RUN=true
RUN_BACKGROUND_LOOP_IN_PROCESS=true
